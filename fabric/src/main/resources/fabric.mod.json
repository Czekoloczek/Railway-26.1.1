{
  "schemaVersion": 1,
  "id": "railways",
  "version": "${version}",
  "name": "Steam 'n' Rails",
  "description": "Expanding Create's railroad network",
  "authors": [
    "The Railways Team",
    "PoppyBlossom",
    "Chameleon538"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/Steam-Rails",
    "sources": "https://github.com/Czekoloczek/Railway-26.1.1"
  },
  "license": "LGPL-3.0",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.railwayteam.railways.fabric.RailwaysFabric"
    ],
    "client": [
      "com.railwayteam.railways.fabric.RailwaysFabricClient"
    ]
  },
  "mixins": [
    "railways-common.mixins.json",
    "railways-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${fabric_mc_version}",
    "fabric-api": "*",
    "create": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
